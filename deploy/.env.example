# SOL DUNK server settings. Copy to deploy/.env and fill in. Amounts are in lamports: 1 SOL = 1000000000.
# docs/LAUNCH.md walks through these in order. On NETWORK=mainnet-beta the server refuses to start until the
# settings marked (mainnet: required) are set, and prints a line for each one that's missing.

# ---- where it runs
DOMAIN=play.example.com                 # the site's address (Caddy gets its HTTPS certificate)
PUBLIC_URL=https://play.example.com     # (mainnet: required) what players type; shown in the wallet's sign-in prompt
NETWORK=devnet                          # devnet for testing, mainnet-beta for real SOL
RPC_URL=                                # (mainnet: required) a dedicated RPC endpoint (Helius, Triton, QuickNode...); one provider, not a mix
TRUST_PROXY=1                           # proxies in front of the app: 1 for the bundled Caddy, 2 with Cloudflare in front of it
POSTGRES_PASSWORD=change-me             # for the bundled database
# DATABASE_URL=postgres://user:pass@host:5432/soldunk   # (mainnet: required; set by docker-compose) a managed Postgres instead

# ---- secrets (make each with: openssl rand -hex 32)
TOKEN_SECRET=                           # (mainnet: required) signs players' sign-in tokens
ADMIN_TOKEN=                            # (mainnet: required) the operator API's password; without it there is no operator API
# ADMIN_IPS=203.0.113.7                 # only these addresses may use the operator API
# ORIGIN_SECRET=                        # your CDN adds the header x-origin-secret with this value; everything else is refused

# ---- wallets
# The hot wallet's key is the file deploy/secrets/house.json (node server/scripts/keygen.mjs deploy/secrets/house.json).
COLD_ADDRESS=                           # (mainnet: required) where sweeps go: a multisig vault (Squads) whose keys never touch this server
# RESERVE_ADDRESSES=                    # other house addresses counted in the bankroll (defaults to COLD_ADDRESS)
HOT_MIN_LAMPORTS=2000000000             # alert when the hot wallet falls below this
HOT_TARGET_LAMPORTS=5000000000          # a sweep leaves this much in the hot wallet
HOT_MAX_LAMPORTS=10000000000            # above this, the excess is swept to COLD_ADDRESS
# PRIORITY_FEE_MICROLAMPORTS=20000      # fee bid for the house's transactions (mainnet default 20000)

# ---- bets and the bankroll (the closed-beta values; raise them as in docs/LAUNCH.md)
MIN_BET_LAMPORTS=1000000                # 0.001 SOL
MAX_BET_LAMPORTS=50000000               # 0.05 SOL
MAX_PAYOUT_LAMPORTS=5000000000          # no single run can pay more than 5 SOL
RISK_FRACTION=0.05                      # one bet's biggest possible win may use at most 5% of the free bankroll
# SPECIAL_MAX_STAKE_LAMPORTS=200000000 # the biggest stake at the special levels (0.2 SOL); see docs/LAUNCH.md before raising it
# DUEL_ENTRY_LAMPORTS=50000000         # the stake a duel starts at (0.05 SOL); the house keeps 10% of each
# DUEL_MAX_STAKE_LAMPORTS=1000000000   # the biggest stake a player can pick in a duel (1 SOL)
# DUEL_WAIT_MS=86400000                # a duel mark nobody takes on is refunded after this long (24 hours)
# POT_ENTRY_LAMPORTS=50000000          # each attempt at the daily pot (0.05 SOL); the best three split it, the house keeps 10%
# SPECIAL_DAY_TRIES=20                  # attempts at each special level per player per day (0 = no limit)

# ---- deposits and withdrawals
MIN_DEPOSIT_LAMPORTS=10000000
# DEPOSIT_DAY_LIMIT_LAMPORTS=5000000000   # per player per day (a player-protection limit; 0 = none)
MIN_WITHDRAW_LAMPORTS=10000000
WITHDRAW_REVIEW_LAMPORTS=2000000000       # one withdrawal this big waits for you to approve it
WITHDRAW_DAY_USER_LAMPORTS=5000000000     # a player's automatic withdrawals per day; more waits for review
WITHDRAW_DAY_TOTAL_LAMPORTS=20000000000   # everyone's automatic withdrawals per day: the circuit breaker
# KYC_WITHDRAW_LAMPORTS=0                 # lifetime withdrawals above this need a verified identity (set by your licence)

# ---- reviews
BIG_WIN_LAMPORTS=2000000000             # a payout this big holds the player's withdrawals until you've looked
# BIG_WIN_X=200                         # ... or a run that reaches this multiplier
# BOT_SCORE_REVIEW=0.8                  # tap-precision score that holds withdrawals (lib/botcheck.mjs)

# ---- who can play
ACCESS=allowlist                        # allowlist = closed beta (only listed wallets can sign in); open = everyone
ALLOWLIST=                              # wallets to start the list with, comma-separated (add more: npm run admin -- allow <address>)
BLOCKED_COUNTRIES=                      # (mainnet: required) country codes to refuse, comma-separated, from your lawyer; "none" blocks none
# GEO_HEADER=cf-ipcountry               # the header your CDN sets with the visitor's country (Cloudflare's by default)
# GEO_REQUIRED=1                        # also refuse visitors whose country is unknown

# ---- monitoring
ALERT_WEBHOOK_URL=                      # a Slack or Discord webhook: held withdrawals, a low hot wallet, big wins, limited accounts
# SENTRY_DSN=                           # error reports (also: npm install @sentry/node in server/)
# LOG_LEVEL=info
