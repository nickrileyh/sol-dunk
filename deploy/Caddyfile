# HTTPS in front of the app. Caddy gets and renews the certificate for $DOMAIN by itself.
#
# Behind Cloudflare (recommended: it supplies the CF-IPCountry header the country block reads, and absorbs abuse),
# turn the DNS record's proxy on, set TRUST_PROXY=2 in .env, and either use a Cloudflare Tunnel so this server has no
# open ports, or add a Cloudflare Transform Rule that sets the request header x-origin-secret to ORIGIN_SECRET: the
# app then refuses anything that didn't come through Cloudflare, so nobody can fake the country header.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8787
}
