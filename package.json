{
  "name": "sol-dunk",
  "version": "1.0.0",
  "private": true,
  "description": "SOL DUNK: a flap-through-the-rings skill game with SOL betting, checkpoints and calibrated multipliers.",
  "scripts": {
    "build": "node build.cjs && SERVER_URL=/ node build.cjs",
    "sim": "node sim/run.cjs",
    "sim:quick": "node sim/run.cjs 0.1",
    "calibrate": "node sim/calibrate.cjs patterns.json --mode edge --write",
    "stats": "node sim/quick.cjs 400",
    "test": "cd server && npm test",
    "check": "node tools/sync_check.cjs",
    "special": "node sim/special.cjs 2000 --write",
    "missions": "node sim/missions.cjs"
  }
}
